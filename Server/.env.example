PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"
JWT_SECRET="generate_a_long_random_64_character_string_for_production"
# ALLOWED_USERS: JSON array with email, bcrypt password hash, and partner member name
ALLOWED_USERS='[{"email":"admin@nutrientsocean.com","passwordHash":"$2a$10$...","member":"Shivanna Gorkal"}]'
# FRONTEND_ORIGIN: Comma-separated list of allowed frontend URLs (no trailing slash)
FRONTEND_ORIGIN="https://admin.nutrientsocean.com,https://nutrientsocean.vercel.app"
# COOKIE_SAME_SITE: Set to 'none' for cross-domain deployments (e.g. Vercel + Render), or 'lax' for same-domain
COOKIE_SAME_SITE="none"
TZ=Asia/Kolkata


